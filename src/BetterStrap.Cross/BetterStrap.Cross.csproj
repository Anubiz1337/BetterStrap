<Project Sdk="LibreWPF.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<StartupObject>BetterStrap.Program</StartupObject>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<PublishTrimmed>false</PublishTrimmed>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<ProGpuWpfSystemFormatsNrbfVersion>10.0.14</ProGpuWpfSystemFormatsNrbfVersion>
		<BaseOutputPath Condition="'$(RuntimeIdentifier)' != '' And '$(BetterStrapLinuxPackagingRoot)' == ''">bin-$(RuntimeIdentifier)\</BaseOutputPath>
		<AssemblyName>BetterStrap</AssemblyName>
		<RootNamespace>BetterStrap</RootNamespace>
		<EnableDefaultItems>false</EnableDefaultItems>
		<DefineConstants>$(DefineConstants);CROSSPLAT</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProGpuWpfUsePortableFrameworkReferences>true</ProGpuWpfUsePortableFrameworkReferences>
		<ProGpuWpfSystemSecurityCryptographyXmlVersion>10.0.13</ProGpuWpfSystemSecurityCryptographyXmlVersion>
		<ProGpuWpfUsePortableWinFormsCompat>false</ProGpuWpfUsePortableWinFormsCompat>
		<ProGpuWpfUseLibreWinForms>false</ProGpuWpfUseLibreWinForms>
		<NoWarn>$(NoWarn);CS8305</NoWarn>
		<BetterStrapElfRid Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('freebsd'))">true</BetterStrapElfRid>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
		<TieredPGO>false</TieredPGO>
		<LinuxProGpuWpfAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\ProGPU.Wpf.dll</LinuxProGpuWpfAssembly>
		<LinuxPresentationCoreAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationCore.dll</LinuxPresentationCoreAssembly>
		<LinuxPresentationFrameworkAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationFramework.dll</LinuxPresentationFrameworkAssembly>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('freebsd'))">
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
	</PropertyGroup>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true'">
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
		<TieredPGO>false</TieredPGO>
		<LinuxProGpuWpfAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\ProGPU.Wpf.dll</LinuxProGpuWpfAssembly>
		<LinuxPresentationCoreAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationCore.dll</LinuxPresentationCoreAssembly>
		<LinuxPresentationFrameworkAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationFramework.dll</LinuxPresentationFrameworkAssembly>
		<LinuxWgpuLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native.so</LinuxWgpuLibrary>
		<LinuxGlfwLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libglfw.so.3</LinuxGlfwLibrary>
		<LinuxWgpuLibrary Condition="$(RuntimeIdentifier.StartsWith('freebsd'))">$(MSBuildProjectDirectory)\..\..\external\LibreWPF\freebsd-x64\libwgpu_native.so</LinuxWgpuLibrary>
		<LinuxGlfwLibrary Condition="$(RuntimeIdentifier.StartsWith('freebsd'))">$(MSBuildProjectDirectory)\..\..\external\LibreWPF\freebsd-x64\libglfw.so.3</LinuxGlfwLibrary>
	</PropertyGroup>

	<ItemGroup Condition="'$(BetterStrapElfRid)' == 'true' And Exists('$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native_gl.so')">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native_gl.so">
			<Link>libwgpu_native_gl.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true'">
		<LinuxEditorCompatLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\libbetterstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<LinuxEditorCompatLibrary Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">$(MSBuildProjectDirectory)\..\..\external\LibreWPF\linux-arm64\libbetterstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<LinuxEditorCompatLibrary Condition="($([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('FreeBSD')))">$(BaseIntermediateOutputPath)editorcompat/$(RuntimeIdentifier)/libbetterstrapeditorcompat.so</LinuxEditorCompatLibrary>
	</PropertyGroup>

	<Target Name="BuildLinuxEditorCompat" BeforeTargets="PrepareForBuild" Condition="('$(BetterStrapElfRid)' == 'true' And ($([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('FreeBSD')))) And '$(BetterStrapFreeBSDNativeDirectory)' == ''" Inputs="$(MSBuildProjectDirectory)/../../build/Packaging/Linux/editor-compat.c;$(MSBuildProjectDirectory)/../../build/Packaging/Linux/build-native-compat.sh" Outputs="$(LinuxEditorCompatLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/Linux/build-native-compat.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(LinuxEditorCompatLibrary)&quot;" />
	</Target>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true' Or $(RuntimeIdentifier.StartsWith('osx'))">
		<VoidImageFileName Condition="'$(BetterStrapElfRid)' == 'true'">libvoidimage.so</VoidImageFileName>
		<VoidImageFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libvoidimage.dylib</VoidImageFileName>
		<VoidImageLibrary>$(BaseIntermediateOutputPath)voidimage/$(RuntimeIdentifier)/$(VoidImageFileName)</VoidImageLibrary>
	</PropertyGroup>

	<Target Name="BuildVoidImage" BeforeTargets="AssignTargetPaths" Condition="('$(VoidImageLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))) And '$(BetterStrapFreeBSDNativeDirectory)' == ''" Inputs="$(MSBuildProjectDirectory)/../../native/voidimage/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidimage/Cargo.lock;@(VoidImageSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidimage.sh" Outputs="$(VoidImageLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidimage.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(VoidImageLibrary)&quot; &quot;$(BaseIntermediateOutputPath)voidimage/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<BetterStrapWslDistro Condition="'$(BetterStrapWslDistro)' == ''">Ubuntu</BetterStrapWslDistro>
		<_VoidImageRootWin>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_VoidImageRootWin>
		<_VoidImageLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VoidImageLibrary)'))))</_VoidImageLibraryWin>
		<_VoidImageTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)voidimage/target'))))</_VoidImageTargetWin>
		<_VoidImageRootWsl>/mnt/$(_VoidImageRootWin.Substring(0, 1).ToLowerInvariant())$(_VoidImageRootWin.Substring(2).Replace('%5C', '/'))</_VoidImageRootWsl>
		<_VoidImageLibraryWsl>/mnt/$(_VoidImageLibraryWin.Substring(0, 1).ToLowerInvariant())$(_VoidImageLibraryWin.Substring(2).Replace('%5C', '/'))</_VoidImageLibraryWsl>
		<_VoidImageTargetWsl>/mnt/$(_VoidImageTargetWin.Substring(0, 1).ToLowerInvariant())$(_VoidImageTargetWin.Substring(2).Replace('%5C', '/'))</_VoidImageTargetWsl>
	</PropertyGroup>

	<Target Name="BuildVoidImageThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/voidimage/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidimage/Cargo.lock;@(VoidImageSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidimage.sh" Outputs="$(VoidImageLibrary)">
		<Exec Command="wsl.exe -d $(BetterStrapWslDistro) -e bash &quot;$(_VoidImageRootWsl)build/Packaging/build-voidimage.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_VoidImageLibraryWsl)&quot; &quot;$(_VoidImageTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="RequireLinuxVoidImage" DependsOnTargets="BuildVoidImage;BuildVoidImageThroughWsl" BeforeTargets="AssignTargetPaths" Condition="'$(BetterStrapElfRid)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(BetterStrapAllowMissingVoidImage)' != 'true'">
		<Error Condition="!Exists('$(VoidImageLibrary)')" Text="libvoidimage.so was not built for $(RuntimeIdentifier). Linux builds cannot show any image without it. Install Rust (and WSL with Rust when building on Windows), or set BetterStrapAllowMissingVoidImage=true to build anyway." />
	</Target>

	<ItemGroup>
		<VoidImageSources Include="$(MSBuildProjectDirectory)/../../native/voidimage/src/**/*.rs" />
	</ItemGroup>

	<Target Name="IncludeVoidImage" DependsOnTargets="BuildVoidImage;BuildVoidImageThroughWsl;RequireLinuxVoidImage" BeforeTargets="AssignTargetPaths" Condition="'$(VoidImageLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(VoidImageLibrary)')" Include="$(VoidImageLibrary)" Link="$(VoidImageFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">
		<VoidLayerLibrary>$(BaseIntermediateOutputPath)voidlayer/$(RuntimeIdentifier)/libbetterstrap_overlay.so</VoidLayerLibrary>
	</PropertyGroup>

	<Target Name="BuildVoidLayer" BeforeTargets="AssignTargetPaths;PrepareResources" Condition="'$(VoidLayerLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/voidlayer/betterstrap_overlay.c;$(MSBuildProjectDirectory)/../../native/voidlayer/shaders.h;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidlayer.sh" Outputs="$(VoidLayerLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidlayer.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(VoidLayerLibrary)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeVoidLayer" DependsOnTargets="BuildVoidLayer" BeforeTargets="AssignTargetPaths;PrepareResources" Condition="'$(VoidLayerLibrary)' != ''">
		<ItemGroup>
			<EmbeddedResource Condition="Exists('$(VoidLayerLibrary)')" Include="$(VoidLayerLibrary)" LogicalName="BetterStrap.Resources.Linux.libbetterstrap_overlay.so" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true' Or $(RuntimeIdentifier.StartsWith('osx'))">
		<VoidClipFileName Condition="'$(BetterStrapElfRid)' == 'true'">libvoidclip.so</VoidClipFileName>
		<VoidClipFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libvoidclip.dylib</VoidClipFileName>
		<VoidClipLibrary>$(BaseIntermediateOutputPath)voidclip/$(RuntimeIdentifier)/$(VoidClipFileName)</VoidClipLibrary>
	</PropertyGroup>

	<ItemGroup>
		<VoidClipSources Include="$(MSBuildProjectDirectory)/../../native/voidclip/src/**/*.rs" />
	</ItemGroup>

	<Target Name="BuildVoidClip" BeforeTargets="AssignTargetPaths" Condition="('$(VoidClipLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))) And '$(BetterStrapFreeBSDNativeDirectory)' == ''" Inputs="$(MSBuildProjectDirectory)/../../native/voidclip/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidclip/Cargo.lock;@(VoidClipSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidclip.sh" Outputs="$(VoidClipLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidclip.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(VoidClipLibrary)&quot; &quot;$(BaseIntermediateOutputPath)voidclip/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<_VoidClipLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VoidClipLibrary)'))))</_VoidClipLibraryWin>
		<_VoidClipTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)voidclip/target'))))</_VoidClipTargetWin>
		<_VoidClipLibraryWsl>/mnt/$(_VoidClipLibraryWin.Substring(0, 1).ToLowerInvariant())$(_VoidClipLibraryWin.Substring(2).Replace('%5C', '/'))</_VoidClipLibraryWsl>
		<_VoidClipTargetWsl>/mnt/$(_VoidClipTargetWin.Substring(0, 1).ToLowerInvariant())$(_VoidClipTargetWin.Substring(2).Replace('%5C', '/'))</_VoidClipTargetWsl>
	</PropertyGroup>

	<Target Name="BuildVoidClipThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/voidclip/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidclip/Cargo.lock;@(VoidClipSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidclip.sh" Outputs="$(VoidClipLibrary)">
		<Exec Command="wsl.exe -d $(BetterStrapWslDistro) -e bash &quot;$(_VoidImageRootWsl)build/Packaging/build-voidclip.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_VoidClipLibraryWsl)&quot; &quot;$(_VoidClipTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeVoidClip" DependsOnTargets="BuildVoidClip;BuildVoidClipThroughWsl" BeforeTargets="AssignTargetPaths" Condition="'$(VoidClipLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(VoidClipLibrary)')" Include="$(VoidClipLibrary)" Link="$(VoidClipFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true' Or $(RuntimeIdentifier.StartsWith('osx'))">
		<VoidRpcFileName Condition="'$(BetterStrapElfRid)' == 'true'">libvoidrpc.so</VoidRpcFileName>
		<VoidRpcFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libvoidrpc.dylib</VoidRpcFileName>
		<VoidRpcLibrary>$(BaseIntermediateOutputPath)voidrpc/$(RuntimeIdentifier)/$(VoidRpcFileName)</VoidRpcLibrary>
	</PropertyGroup>

	<ItemGroup>
		<VoidRpcSources Include="$(MSBuildProjectDirectory)/../../native/voidrpc/src/**/*.rs" />
	</ItemGroup>

	<Target Name="BuildVoidRpc" BeforeTargets="AssignTargetPaths" Condition="('$(VoidRpcLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))) And '$(BetterStrapFreeBSDNativeDirectory)' == ''" Inputs="$(MSBuildProjectDirectory)/../../native/voidrpc/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidrpc/Cargo.lock;@(VoidRpcSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidrpc.sh" Outputs="$(VoidRpcLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidrpc.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(VoidRpcLibrary)&quot; &quot;$(BaseIntermediateOutputPath)voidrpc/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<_VoidRpcLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VoidRpcLibrary)'))))</_VoidRpcLibraryWin>
		<_VoidRpcTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)voidrpc/target'))))</_VoidRpcTargetWin>
		<_VoidRpcLibraryWsl>/mnt/$(_VoidRpcLibraryWin.Substring(0, 1).ToLowerInvariant())$(_VoidRpcLibraryWin.Substring(2).Replace('%5C', '/'))</_VoidRpcLibraryWsl>
		<_VoidRpcTargetWsl>/mnt/$(_VoidRpcTargetWin.Substring(0, 1).ToLowerInvariant())$(_VoidRpcTargetWin.Substring(2).Replace('%5C', '/'))</_VoidRpcTargetWsl>
	</PropertyGroup>

	<Target Name="BuildVoidRpcThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/voidrpc/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidrpc/Cargo.lock;@(VoidRpcSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidrpc.sh" Outputs="$(VoidRpcLibrary)">
		<Exec Command="wsl.exe -d $(BetterStrapWslDistro) -e bash &quot;$(_VoidImageRootWsl)build/Packaging/build-voidrpc.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_VoidRpcLibraryWsl)&quot; &quot;$(_VoidRpcTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeVoidRpc" DependsOnTargets="BuildVoidRpc;BuildVoidRpcThroughWsl" BeforeTargets="AssignTargetPaths" Condition="'$(VoidRpcLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(VoidRpcLibrary)')" Include="$(VoidRpcLibrary)" Link="$(VoidRpcFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true' Or $(RuntimeIdentifier.StartsWith('osx'))">
		<VoidLogFileName Condition="'$(BetterStrapElfRid)' == 'true'">libvoidlog.so</VoidLogFileName>
		<VoidLogFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libvoidlog.dylib</VoidLogFileName>
		<VoidLogLibrary>$(BaseIntermediateOutputPath)voidlog/$(RuntimeIdentifier)/$(VoidLogFileName)</VoidLogLibrary>
	</PropertyGroup>

	<ItemGroup>
		<VoidLogSources Include="$(MSBuildProjectDirectory)/../../native/voidlog/src/**/*.rs" />
	</ItemGroup>

	<Target Name="BuildVoidLog" BeforeTargets="AssignTargetPaths" Condition="('$(VoidLogLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))) And '$(BetterStrapFreeBSDNativeDirectory)' == ''" Inputs="$(MSBuildProjectDirectory)/../../native/voidlog/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidlog/Cargo.lock;@(VoidLogSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidlog.sh" Outputs="$(VoidLogLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidlog.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(VoidLogLibrary)&quot; &quot;$(BaseIntermediateOutputPath)voidlog/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<_VoidLogLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VoidLogLibrary)'))))</_VoidLogLibraryWin>
		<_VoidLogTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)voidlog/target'))))</_VoidLogTargetWin>
		<_VoidLogLibraryWsl>/mnt/$(_VoidLogLibraryWin.Substring(0, 1).ToLowerInvariant())$(_VoidLogLibraryWin.Substring(2).Replace('%5C', '/'))</_VoidLogLibraryWsl>
		<_VoidLogTargetWsl>/mnt/$(_VoidLogTargetWin.Substring(0, 1).ToLowerInvariant())$(_VoidLogTargetWin.Substring(2).Replace('%5C', '/'))</_VoidLogTargetWsl>
	</PropertyGroup>

	<Target Name="BuildVoidLogThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/voidlog/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidlog/Cargo.lock;@(VoidLogSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidlog.sh" Outputs="$(VoidLogLibrary)">
		<Exec Command="wsl.exe -d $(BetterStrapWslDistro) -e bash &quot;$(_VoidImageRootWsl)build/Packaging/build-voidlog.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_VoidLogLibraryWsl)&quot; &quot;$(_VoidLogTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeVoidLog" DependsOnTargets="BuildVoidLog;BuildVoidLogThroughWsl" BeforeTargets="AssignTargetPaths" Condition="'$(VoidLogLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(VoidLogLibrary)')" Include="$(VoidLogLibrary)" Link="$(VoidLogFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(BetterStrapElfRid)' == 'true' Or $(RuntimeIdentifier.StartsWith('osx'))">
		<VoidStateFileName Condition="'$(BetterStrapElfRid)' == 'true'">libvoidstate.so</VoidStateFileName>
		<VoidStateFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libvoidstate.dylib</VoidStateFileName>
		<VoidStateLibrary>$(BaseIntermediateOutputPath)voidstate/$(RuntimeIdentifier)/$(VoidStateFileName)</VoidStateLibrary>
	</PropertyGroup>

	<PropertyGroup Condition="'$(BetterStrapFreeBSDNativeDirectory)' != ''">
		<LinuxWgpuLibrary>$(BetterStrapFreeBSDNativeDirectory)libwgpu_native.so</LinuxWgpuLibrary>
		<LinuxGlfwLibrary>$(BetterStrapFreeBSDNativeDirectory)libglfw.so.3</LinuxGlfwLibrary>
		<LinuxEditorCompatLibrary>$(BetterStrapFreeBSDNativeDirectory)libbetterstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<VoidImageLibrary>$(BetterStrapFreeBSDNativeDirectory)$(VoidImageFileName)</VoidImageLibrary>
		<VoidClipLibrary>$(BetterStrapFreeBSDNativeDirectory)$(VoidClipFileName)</VoidClipLibrary>
		<VoidRpcLibrary>$(BetterStrapFreeBSDNativeDirectory)$(VoidRpcFileName)</VoidRpcLibrary>
		<VoidLogLibrary>$(BetterStrapFreeBSDNativeDirectory)$(VoidLogFileName)</VoidLogLibrary>
		<VoidStateLibrary>$(BetterStrapFreeBSDNativeDirectory)$(VoidStateFileName)</VoidStateLibrary>
	</PropertyGroup>

	<ItemGroup>
		<VoidStateSources Include="$(MSBuildProjectDirectory)/../../native/voidstate/src/**/*.rs" />
	</ItemGroup>

	<Target Name="BuildVoidState" BeforeTargets="AssignTargetPaths" Condition="('$(VoidStateLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))) And '$(BetterStrapFreeBSDNativeDirectory)' == ''" Inputs="$(MSBuildProjectDirectory)/../../native/voidstate/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidstate/Cargo.lock;@(VoidStateSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidstate.sh" Outputs="$(VoidStateLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-voidstate.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(VoidStateLibrary)&quot; &quot;$(BaseIntermediateOutputPath)voidstate/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<_VoidStateLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VoidStateLibrary)'))))</_VoidStateLibraryWin>
		<_VoidStateTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)voidstate/target'))))</_VoidStateTargetWin>
		<_VoidStateLibraryWsl>/mnt/$(_VoidStateLibraryWin.Substring(0, 1).ToLowerInvariant())$(_VoidStateLibraryWin.Substring(2).Replace('%5C', '/'))</_VoidStateLibraryWsl>
		<_VoidStateTargetWsl>/mnt/$(_VoidStateTargetWin.Substring(0, 1).ToLowerInvariant())$(_VoidStateTargetWin.Substring(2).Replace('%5C', '/'))</_VoidStateTargetWsl>
	</PropertyGroup>

	<Target Name="BuildVoidStateThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/voidstate/Cargo.toml;$(MSBuildProjectDirectory)/../../native/voidstate/Cargo.lock;@(VoidStateSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-voidstate.sh" Outputs="$(VoidStateLibrary)">
		<Exec Command="wsl.exe -d $(BetterStrapWslDistro) -e bash &quot;$(_VoidImageRootWsl)build/Packaging/build-voidstate.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_VoidStateLibraryWsl)&quot; &quot;$(_VoidStateTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeVoidState" DependsOnTargets="BuildVoidState;BuildVoidStateThroughWsl" BeforeTargets="AssignTargetPaths" Condition="'$(VoidStateLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(VoidStateLibrary)')" Include="$(VoidStateLibrary)" Link="$(VoidStateFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<ItemGroup Condition="'$(BetterStrapElfRid)' == 'true'">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\GLFW-LICENSE.txt" Condition="Exists('$(LinuxGlfwLibrary)')">
			<Link>GLFW-LICENSE.txt</Link>

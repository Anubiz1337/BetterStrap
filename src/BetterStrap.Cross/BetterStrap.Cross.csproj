		<ItemGroup>
			<_FilesToBundle Remove="@(_BetterStrapFreeBSDBundleAssembly)" />
			<_FilesToBundle Include="@(_BetterStrapFreeBSDBundleAssembly->'$(BetterStrapFreeBSDPatchDirectory)%(Filename)%(Extension)')" />
		</ItemGroup>
	</Target>

	<Import Project="..\BetterStrap.App\CompressedStrings.targets" />

